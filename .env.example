# Copy to .env and fill in. .env is git-ignored.

# Required for AI answers. Without it the app runs in "search only" demo mode.
ANTHROPIC_API_KEY=

# Optional tuning
# CLAUDE_MODEL=claude-haiku-5-5   # or claude-sonnet-5-5 / claude-opus-5-5 for harder questions
# CHATBOT_EFFORT=low           # low | medium | high (higher = slower, more thorough)
# MAX_TOOL_STEPS=5             # max search/read rounds per question

# Scraper etiquette
# SCRAPER_USER_AGENT=PriceChatbotPOC/0.1 (University of Utah student proof-of-concept; contact you@utah.edu)
# CRAWL_DELAY=10               # seconds between indexer requests (robots.txt asks for 10)
# LIVE_FETCH_INTERVAL=2        # seconds between live page reads per host

# Freshness
# AUTO_SYNC=true               # false on Cloud Run, which pauses the server between requests
# SYNC_TTL_MINUTES=30          # check sites for edits when a question arrives and the last check is older
# RECONCILE_DAYS=7             # how often to also look for deleted/unpublished pages
# TRUMBA_CALENDAR=uu-college-of-engineering
# EVENTS_CACHE_TTL=900         # seconds to reuse a calendar response

# Abuse and cost protection (see docs/SECURITY.md)
# DAILY_BUDGET_USD=5            # app-side daily cap; when hit, answers fall back to search results
# TOKEN_LIMITS=5/60,30/3600,100/86400     # per browser: requests/seconds
# IP_LIMITS=30/60,300/3600,1000/86400     # per IP backstop (campus Wi-Fi shares IPs)
# GLOBAL_CHAT_LIMITS=30/60,600/3600
# MAX_CONCURRENT_ANSWERS=8
# MAX_OUTPUT_TOKENS=3000
# MAX_CONTEXT_TOKENS=40000      # then the chat asks to start a new conversation
# SCOPE_GATE=true               # classify each message before answering
# TRUST_PROXY=false             # true ONLY behind a proxy you control (Cloudflare, load balancer)
# CHAT_TOKEN_SECRET=            # set in production; otherwise generated into data/.token_secret
# BETA_PASSWORD=                # if set, browsers need this shared password (web/login.html) to get a token
# LOGIN_LIMITS=10/600           # wrong passwords per IP
# ALLOWED_ORIGINS=              # other sites whose pages may call the API, comma-separated

# Usage records (see docs/DEPLOY.md)
# LOG_BACKEND=files             # files (data/*.jsonl) or firestore
# LOG_RETENTION_DAYS=90         # Firestore deletes records after this many days
