# Copy to .env and fill in. .env is git-ignored. Every value below is the default in app/config.py.

# Required for AI answers. Without it the app runs in "search only" demo mode.
ANTHROPIC_API_KEY=

# Model and answers
# CLAUDE_MODEL=claude-haiku-5-5     # a change needs a PRICES entry in app/pricing.py and an answer-eval run
# SCOPE_GATE_MODEL=claude-haiku-5-5 # the small classifier that labels each message first
# SCOPE_GATE=true                   # classify each message before answering
# CHATBOT_EFFORT=low                # low | medium | high (higher = slower, more thorough)
# MAX_TOOL_STEPS=3                  # search/read rounds per question
# MAX_OUTPUT_TOKENS=3000            # per model call, thinking included
# MAX_TURNS_PER_SESSION=20
# MAX_CONTEXT_TOKENS=70000          # then the chat asks to start a new conversation
# SESSION_IDLE_MINUTES=30           # conversations are forgotten after this long idle
# MAX_MESSAGE_CHARS=1000
# ANSWER_CACHE_HOURS=6              # repeated first questions; 0 = off

# Scraper etiquette
# SCRAPER_USER_AGENT=PriceChatbotPOC/0.1 (University of Utah student proof-of-concept)
# CRAWL_DELAY=10                    # seconds between indexer requests (robots.txt asks for 10)
# LIVE_FETCH_INTERVAL=2             # seconds between live page reads per host
# LIVE_CACHE_TTL=3600               # seconds to reuse a live page read

# Freshness
# AUTO_SYNC=true                    # false on Cloud Run; needs all of data/ on a lasting disk (docs/ARCHITECTURE.md)
# SYNC_TTL_MINUTES=30               # check sites for edits when a question arrives and the last check is older
# RECONCILE_DAYS=7                  # how often to also look for deleted pages and refresh the PDFs
# TRUMBA_CALENDAR=uu-college-of-engineering
# EVENTS_CACHE_TTL=900              # seconds to reuse a calendar response

# Rate limits: "requests/seconds", comma-separated (docs/ARCHITECTURE.md, "Protections")
# TOKEN_LIMITS=5/60,30/3600,100/86400     # per browser
# IP_LIMITS=30/60,300/3600,1000/86400     # per IP (campus Wi-Fi shares IPs)
# GLOBAL_CHAT_LIMITS=30/60,600/3600       # everyone combined; sized for the beta (docs/GOING_LIVE.md)
# TOKEN_ISSUE_LIMITS=60/3600              # new browser tokens per IP
# SEARCH_LIMITS=20/60
# EVENTS_LIMITS=60/60
# FEEDBACK_LIMITS=5/60,50/86400
# SUMMARY_LIMITS=3/600,10/86400           # chat-summary PDFs per browser
# MAX_CONCURRENT_ANSWERS=8
# MAX_CONCURRENT_PER_CLIENT=1

# Money
# DAILY_BUDGET_USD=5                # app-side daily cap; when hit, answers fall back to search results; 0 = no cap

# Access
# TRUST_PROXY=false                 # true ONLY behind a proxy you control (Cloudflare, load balancer, Cloud Run)
# CHAT_TOKEN_SECRET=                # set on a server; otherwise generated into data/.token_secret
# TOKEN_TTL_HOURS=24                # how long a browser token lasts
# BETA_PASSWORD=                    # if set, browsers need this shared password (web/login.html) to get a token
# LOGIN_LIMITS=10/600               # wrong passwords per IP
# ALLOWED_ORIGINS=                  # other sites whose pages may call the API, comma-separated

# Usage records (docs/DEPLOY.md)
# LOG_BACKEND=files                 # files (data/*.jsonl) or firestore
# LOG_RETENTION_DAYS=90             # Firestore deletes records after this many days
